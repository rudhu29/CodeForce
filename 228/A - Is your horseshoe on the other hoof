import java.util.Scanner;
import java.util.HashSet;
 
public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        HashSet<Integer> uniqueColors = new HashSet<>();
        
        // Read the 4 horseshoe colors from the input
        for (int i = 0; i < 4; i++) {
            uniqueColors.add(scanner.nextInt());
        }
        
        // The number of horseshoes to buy is 4 minus the unique colors he already has
        int horseshoesToBuy = 4 - uniqueColors.size();
        
        // Print the result
        System.out.println(horseshoesToBuy);
        
        scanner.close();
    }
}